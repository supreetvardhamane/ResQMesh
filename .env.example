# ResQMesh — Environment Variable Template
# -----------------------------------------
# Copy this file to .env and fill in real values.
# The .env file is git-ignored. NEVER commit .env with real credentials.
#
# Usage:
#   cp .env.example .env   # then edit .env

# ── Database ─────────────────────────────────────────────────────────────────
# Local development default (matches infra/compose.yaml)
DATABASE_URL=postgresql+psycopg://resqmesh:resqmesh_dev@localhost:5432/resqmesh
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins (use specific origins in production)
API_CORS_ORIGINS=http://localhost:5173

# ── Feature flags ────────────────────────────────────────────────────────────
ENABLE_SIGNATURE_VERIFICATION=true
ENABLE_RATE_LIMITING=true

# ── Demo ─────────────────────────────────────────────────────────────────────
DEMO_INCIDENT_ID=demo-flood-2026
